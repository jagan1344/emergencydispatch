# ---------------------------------------------------------------------------
# AI Emergency Dispatch - environment configuration (copy to .env)
# ---------------------------------------------------------------------------
# PostgreSQL + PostGIS (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ems
# Database used by the automated test-suite (will be wiped by tests!)
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ems_test

# Redis is NOT used by this project (in-process caches are sufficient at this scale).
# Kept only so the variable exists if you later add a Redis-backed cache.
REDIS_URL=

# Mosquitto MQTT broker
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_ENABLED=true

# Local OSRM routing server (leave empty to use only the built-in graph router)
OSRM_URL=http://localhost:5000

# JWT signing secret - CHANGE THIS. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-dev-only-secret
JWT_EXPIRE_MINUTES=480

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Service region. The road graph is imported for a circle of CITY_RADIUS_M around the centre.
CITY_NAME=Bengaluru
CITY_LAT=12.9716
CITY_LON=77.5946
CITY_RADIUS_M=6000
# Path to an OSM extract (.osm from scripts/fetch_osm.py, or .osm.pbf). If missing, a synthetic grid road
# network is generated (demo fallback). scripts/setup_real_data.ps1 fills these values in for you.
OSM_PBF_PATH=../data/maps/bengaluru.osm
# Optional CSV with VERIFIED hospital capabilities (created by: python -m app.hospital_data export ...)
HOSPITALS_CSV=

# Simulation: 1 wall-clock second = SIM_TIME_SCALE simulated seconds
SIM_TIME_SCALE=4
SCENE_TIME_S=120
HANDOVER_TIME_S=90
AUTO_DISPATCH=true

LOG_LEVEL=INFO

# ---- Decision intelligence (all optional; defaults shown). Times are SIMULATED seconds/minutes
# unless marked "wall".
# Confidence-aware dispatch: top-class probability >= HIGH -> AUTO_DISPATCH, < LOW -> HUMAN_REVIEW,
# in between -> DISPATCH_WITH_REVIEW. A HUMAN_REVIEW case is released after HUMAN_REVIEW_TIMEOUT_S (wall)
# at the most severe plausible level.
DISPATCH_CONFIDENCE_HIGH=0.75
DISPATCH_CONFIDENCE_LOW=0.50
HUMAN_REVIEW_TIMEOUT_S=120
# Predictive traffic / hospital congestion
TRAFFIC_PREDICTION_HORIZON_MIN=10
HOSPITAL_PREDICTION_HORIZON_MIN=10
# Resource reallocation: considered when the best free unit's ETA exceeds this many seconds
RESOURCE_REALLOCATION_THRESHOLD=480
REALLOCATION_MIN_GAIN_S=120
REALLOCATION_MAX_DONOR_DELAY_S=300
# Telemetry-driven re-routing: accept only if new ETA + max(savings, old ETA x percent) <= old ETA
REROUTE_MIN_ETA_SAVINGS=20
REROUTE_MIN_IMPROVEMENT_PERCENT=5
REROUTE_COOLDOWN_SECONDS=90
