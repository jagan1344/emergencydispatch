# ---------------------------------------------------------------------------
# AI Emergency Dispatch - environment configuration (copy to .env)
# ---------------------------------------------------------------------------
# PostgreSQL + PostGIS (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ems
# Database used by the automated test-suite (will be wiped by tests!)
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ems_test

# Redis is NOT used by this project (in-process caches are sufficient at this scale).
# Kept only so the variable exists if you later add a Redis-backed cache.
REDIS_URL=

# Mosquitto MQTT broker
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_ENABLED=true

# Local OSRM routing server (leave empty to use only the built-in graph router)
OSRM_URL=http://localhost:5000

# JWT signing secret - CHANGE THIS. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-dev-only-secret
JWT_EXPIRE_MINUTES=480

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Service region. The road graph is imported for a circle of CITY_RADIUS_M around the centre.
CITY_NAME=Bengaluru
CITY_LAT=12.9716
CITY_LON=77.5946
CITY_RADIUS_M=6000
# Path to an OSM .pbf extract. If missing, a synthetic grid road network is generated (demo fallback).
OSM_PBF_PATH=../data/maps/bengaluru.osm.pbf

# Simulation: 1 wall-clock second = SIM_TIME_SCALE simulated seconds
SIM_TIME_SCALE=4
SCENE_TIME_S=120
HANDOVER_TIME_S=90
AUTO_DISPATCH=true

LOG_LEVEL=INFO
